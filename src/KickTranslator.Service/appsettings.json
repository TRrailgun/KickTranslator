{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting": "Warning"
    }
  },
  "Translator": {
    "Listen": "http://127.0.0.1:5757",

    "TranslationModelsBaseUrl": "https://github.com/TRrailgun/KickTranslator/releases/download/modeller-v1/",

    "Device": "auto",
    "WhisperModel": "",
    "FfmpegPath": "ffmpeg",

    "FirstChunkSeconds": 8,
    "ChunkSeconds": 20,
    "MaxLeadSeconds": 90,
    "Threads": 0,

    "LiveMinSeconds": 1.5,
    "LiveMaxSeconds": 6.0,
    "LivePartials": "auto",
    "LivePartialIntervalSeconds": 1.0
  }
}
