{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting": "Warning"
    }
  },
  "Translator": {
    "Listen": "http://127.0.0.1:5757",

    "TranslationModelsBaseUrl": "https://github.com/TRrailgun/KickTranslator/releases/download/modeller-v3/",

    "Device": "auto",
    "GpuTier": "auto",
    "WhisperModel": "",
    "FfmpegPath": "ffmpeg",

    "FirstChunkSeconds": 4,
    "ChunkSeconds": 20,
    "MaxLeadSeconds": 90,
    "Threads": 0,

    "LiveMinSeconds": 1.5,
    "LiveMaxSeconds": 6.0,
    "LivePartials": "auto",
    "Segmenter": "vad",
    "LivePartialIntervalSeconds": 1.0,

    "TranslationEngine": "auto",
    "LlmPort": 5767,
    "LlmContextLines": 3,
    "LlmTimeoutSeconds": 2.5
  }
}
