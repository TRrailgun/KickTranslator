<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>KickTranslator</RootNamespace>
    <AssemblyName>KickCeviri</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Kick Çeviri</Product>
    <Version>1.0.0</Version>
    <Company>Kick Çeviri</Company>
  </PropertyGroup>

  <!-- Yayın derlemesi: kullanıcının .NET kurmasına gerek kalmasın -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Konuşma tanıma: whisper.cpp .NET bağlantısı -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <!-- Donanım arka uçları: açılışta sırayla denenir (CUDA -> Vulkan -> CPU) -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime.Cuda.Windows" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.8.1" />

    <!-- Çeviri: Opus-MT (Marian) ONNX modeli -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
